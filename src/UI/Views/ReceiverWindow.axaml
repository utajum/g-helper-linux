<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:GHelper.Linux.UI.Controls"
        x:Class="GHelper.Linux.UI.Views.ReceiverWindow"
        Title="Logitech receivers"
        Width="460"
        MinWidth="380"
        MinHeight="220"
        MaxHeight="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        CanResize="True"
        Background="#1C1C1C"
        Icon="avares://ghelper/UI/Assets/standard.ico">

    <Grid Margin="12" RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Classes="panel">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ctrl:Icon IconName="keyboard" Width="18" Height="18" VerticalAlignment="Center" />
                    <TextBlock x:Name="labelHeader" Classes="header"
                               Text="Logitech receivers" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="buttonRefresh" Classes="ghelper"
                        Click="ButtonRefresh_Click" Padding="10,4" FontSize="11">
                    <TextBlock x:Name="labelRefresh" Text="Refresh" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,8,0,0">
            <StackPanel x:Name="panelReceivers" Spacing="8" Margin="0,0,2,0" />
        </ScrollViewer>

        <Border Grid.Row="2" x:Name="panelStatus" Classes="panel" Margin="0,8,0,0" IsVisible="False">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" x:Name="labelStatus" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Grid.Column="1" x:Name="buttonCancel" Classes="ghelper"
                        Click="ButtonCancel_Click" Padding="10,4" FontSize="11" IsVisible="False"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="labelCancel" Text="Cancel" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

    </Grid>
</Window>
