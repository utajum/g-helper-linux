<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Native AOT for single-binary deployment -->
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <StripSymbols>true</StripSymbols>

    <!-- Keep globalization for localization support -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Trim aggressively -->
    <TrimMode>full</TrimMode>
    <OptimizationPreference>Size</OptimizationPreference>

    <!-- App metadata -->
    <AssemblyName>ghelper</AssemblyName>
    <RootNamespace>GHelper.Linux</RootNamespace>
    <!-- ApplicationIcon is Windows-only; on Linux we use .desktop file icon -->
    <Version>1.0.0</Version>
    <Description>G-Helper for Linux - ASUS laptop control utility</Description>
  </PropertyGroup>

  <!-- Avalonia UI framework -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />

    <!--
      Native asset packages are pulled transitively by Avalonia, but we pin them
      explicitly with GeneratePathProperty so the EmbeddedResource target below
      can reference a single unambiguous path via $(PkgSkiaSharp_NativeAssets_Linux)
      and $(PkgHarfBuzzSharp_NativeAssets_Linux). Versions must match what
      Avalonia resolves to avoid downgrade warnings.
    -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" GeneratePathProperty="true" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="7.3.0.3" GeneratePathProperty="true" />

    <!-- HID communication (cross-platform, used by G-Helper) -->
    <PackageReference Include="HidSharpCore" Version="1.3.0" />
  </ItemGroup>

  <!-- Embed all assets -->
  <ItemGroup>
    <AvaloniaResource Include="UI\Assets\**" />
    <AvaloniaResource Include="UI\Styles\**" />
  </ItemGroup>

  <!-- AOT trimmer configuration -->
  <ItemGroup>
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
  </ItemGroup>

  <!--
    Embed native .so libraries as resources for single-binary deployment.
    At runtime, NativeLibExtractor extracts them to ~/.cache/ghelper/libs/
    and preloads them before SkiaSharp/Avalonia initializes.
  -->
  <Target Name="EmbedNativeLibraries" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <EmbeddedResource Include="$(PkgSkiaSharp_NativeAssets_Linux)/runtimes/linux-x64/native/libSkiaSharp.so"
                        LogicalName="libSkiaSharp.so" />
      <EmbeddedResource Include="$(PkgHarfBuzzSharp_NativeAssets_Linux)/runtimes/linux-x64/native/libHarfBuzzSharp.so"
                        LogicalName="libHarfBuzzSharp.so" />
    </ItemGroup>
  </Target>

</Project>
