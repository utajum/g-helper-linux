<Project Sdk="Microsoft.NET.Sdk">

  <!--
    GPUModeControl scenario tests.

    Validates every (PCI backend, raw-WMI backend, current hw state,
    button press) combination so the UI never lies about the active GPU
    mode and the configured backend is honoured end-to-end. The runner
    is a plain Main(string[]) console executable so it works without
    pulling xUnit / dotnet-test into the AOT main binary.

    Build and run:
      dotnet run -c Debug (project tests/GHelper.Linux.Tests)
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GHelper.Linux.Tests</RootNamespace>
    <AssemblyName>ghelper-tests</AssemblyName>

    <!-- NOT AOT - tests use reflection, dynamic dispatch, etc. -->
    <PublishAot>false</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Suppress accidental TrimMode inheritance -->
    <TrimMode>partial</TrimMode>

    <!-- We don't want to compile any Avalonia .axaml from the main proj. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>

    <!-- Doc comments are checked only for crefs: a cref left behind by a move fails the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1570;CS1591</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS1574;CS1580;CS1584</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Only compile the C# files we strictly need. Avoids dragging in
      Avalonia UI, Skia, HID, etc. Keeps the test build fast and
      side-effect-free.
    -->
    <Compile Include="*.cs" />
    <Compile Include="../../src/Display/XrandrBackend.cs" />
    <Compile Include="../../src/Display/IDisplayBackend.cs" />

    <Compile Include="../../src/Gpu/GPUModeControl.cs" />
    <Compile Include="../../src/Gpu/IGpuBackend.cs" />
    <Compile Include="../../src/Gpu/FirmwareGpuBackend.cs" />
    <Compile Include="../../src/Gpu/PciGpuBackend.cs" />
    <Compile Include="../../src/Gpu/BpfGpuBackend.cs" />
    <Compile Include="../../src/Gpu/DgpuDriver.cs" />
    <Compile Include="../../src/Gpu/DgpuPci.cs" />
    <Compile Include="../../src/Gpu/GpuBootFiles.cs" />
    <Compile Include="../../src/Gpu/GpuSwitchNotice.cs" />
    <Compile Include="../../src/Gpu/MuxLatch.cs" />
    <Compile Include="../../src/Gpu/NVidia/GpuQueryGate.cs" />
    <!-- eBPF GPU block: GPUModeControl dispatches to it, and the parsers are
         covered directly by the scenario tests. -->
    <Compile Include="../../src/Gpu/Block/GpuBlockCapability.cs" />
    <Compile Include="../../src/Gpu/Block/GpuBlockControl.cs" />
    <Compile Include="../../src/Gpu/Block/GpuBlockSetup.cs" />
    <Compile Include="../../src/Gpu/Block/DgpuPowerMonitor.cs" />
    <Compile Include="../../src/Gpu/Block/DgpuDisplay.cs" />
    <Compile Include="../../src/Platform/Linux/UdevMonitor.cs" />
    <Compile Include="../../src/Gpu/Block/GpuBlockPolicy.cs" />
    <!-- GpuProcessList: pure SplitNodes/Classify helpers covered directly. -->
    <Compile Include="../../src/Gpu/Block/GpuProcessList.cs" />
    <Compile Include="../../src/Gpu/Block/GpuAppCatalog.cs" />
    <Compile Include="../../src/Cli/DgpuLauncher.cs" />
    <Compile Include="../../src/Gpu/NVidia/NvidiaProcessScanner.cs" />
    <!-- LinuxNvidiaGpuControl.GetTempViaNvml() NVML temp fallback + its interface -->
    <Compile Include="../../src/Gpu/NVidia/LinuxNvidiaGpuControl.cs" />
    <Compile Include="../../src/Platform/IGpuControl.cs" />
    <Compile Include="../../src/Platform/ISystemIntegration.cs" />
    <Compile Include="../../src/Platform/IHardwareControl.cs" />
    <Compile Include="../../src/Platform/IPowerManager.cs" />
    <Compile Include="../../src/Platform/Linux/Asus/AsusAttributes.cs" />
    <Compile Include="../../src/Platform/Linux/Asus/AsusAttributeRange.cs" />
    <Compile Include="../../src/Mode/PowerLimitBounds.cs" />
    <Compile Include="../../src/Platform/Linux/SysfsHelper.cs" />
    <!-- NixOS (gpu-helper resolve) + RyzenPower (PPT); SysfsHelper-only helpers -->
    <Compile Include="../../src/Platform/Linux/NixOS.cs" />
    <Compile Include="../../src/Platform/Linux/RyzenPower.cs" />
    <!-- ImmutableOs: SysfsHelper.DefaultGpuHelperInstallPath (SteamOS sealed root) -->
    <Compile Include="../../src/Platform/Linux/ImmutableOs.cs" />
    <!-- LinuxAsusWmi + AsusWmiDebugfs: needed by the direct unit tests for
         the GPU-panel visibility logic (IsGpuEcoAvailable, CanToggleGpuBackend,
         IsPciBackendUsable, InvalidateGpuPresenceCache). The class also has a
         heavyweight constructor that probes hwmon, but tests exercise only
         the static helpers so we never instantiate it. -->
    <Compile Include="../../src/Platform/Linux/Asus/LinuxAsusWmi.cs" />
    <Compile Include="../../src/Platform/Linux/Asus/AsusWmiDebugfs.cs" />
    <Compile Include="../../src/Fan/ManualFanMath.cs" />
    <Compile Include="../../src/Mode/AppProfiles.Match.cs" />
    <Compile Include="../../src/Peripherals/Logitech/HidPP/HidPPDecode.cs" />
    <Compile Include="../../src/Input/NumberPadLayouts.cs" />
    <Compile Include="../../src/Helpers/AppConfig.cs" />
    <Compile Include="../../src/Helpers/Logger.cs" />
    <Compile Include="../../src/Helpers/MemoryHelper.cs" />
    <!-- Labels.Get() in LinuxNvidiaGpuControl; pulls all language tables -->
    <Compile Include="../../src/I18n/**/*.cs" />
  </ItemGroup>

</Project>
